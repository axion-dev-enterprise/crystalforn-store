{
  "name": "@digital-store/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/operations/migrate.js && node dist/src/main.js",
    "migrate": "npm run build && node dist/src/operations/migrate.js",
