    "provision-admin": "node dist/operations/provision-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4"
  }
}
