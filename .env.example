# Required runtime configuration. Copy into the local secret store; never commit .env.
NODE_ENV=development
PORT=4000
WEB_PORT=3000
POSTGRES_DB=digital_store
POSTGRES_USER=store
POSTGRES_PASSWORD=change-this-random-password
DATABASE_URL=postgresql://store:change-this-random-password@postgres:5432/digital_store
DATABASE_POOL_MAX=10
APP_ORIGIN=http://localhost:3000
INTERNAL_API_ORIGIN=http://api:4000
SYNC_WORKER_SECRET=replace-with-a-long-random-secret
PURCHASE_TERMS_APPROVED=false
PURCHASE_TERMS_VERSION=
# Must match the identity architecture reference published in auth-governance-status.ts.
STORE_AUTHORIZATION_REFERENCE=
STORE_AUTH_CENTER_URL=https://identity.example.com
STORE_AUTH_CLIENT_SECRET=configure-in-your-secret-manager
# These references must match documentary approvals published in commerce-release-status.ts.
MARKETPLACE_COMPLIANCE_REFERENCE=
MERCADOPAGO_CATEGORY_APPROVAL_REFERENCE=
PUSHINPAY_CATEGORY_APPROVAL_REFERENCE=

# Use a random 32-byte key encoded as 64 hexadecimal characters.
SESSION_PEPPER=replace-with-64-hex-characters
DELIVERY_ENCRYPTION_KEY=replace-with-64-hex-characters

# LZT Market API; set API_PROVIDER=generic only for a supplier using the supplied manual contract.
API_PROVIDER=lzt-market
API_BASE_URL=https://api.lzt.market/
LZT_MARKET_API_TOKEN=configure-in-vault
# API_TOKEN is used only when API_PROVIDER=generic.
API_TOKEN=
API_SYNC_INTERVAL_SECONDS=30
API_RATE_DELAY_MS=3000
API_MAX_SYNC_PAGES=500
API_IMPORT_BATCH_MAX_BYTES=1500000
API_REVALIDATE_MAX_PAGES=100
API_REQUEST_TIMEOUT_MS=10000
LZT_BALANCE_ID=
# Must match the currency of the selected supplier balance and catalog item price.
LZT_BALANCE_CURRENCY=
LZT_FULFILLMENT_TIMEOUT_MS=300000

# Operator-managed FX rates, BRL units per currency unit. Keep empty until verified.
USD_BRL_RATE=
RUB_BRL_RATE=
DEFAULT_MARKUP_PERCENT=55
SELLER_ID_BLOCKLIST=

# Mercado Pago Pix. The API stays disabled until all values are configured.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=

# Pushin Pay Pix cash-in; configure X-PushinPay-Secret with this value in provider panel.
PUSHINPAY_API_BASE_URL=https://api.pushinpay.com.br
PUSHINPAY_ACCESS_TOKEN=
PUSHINPAY_WEBHOOK_SECRET=
PUSHINPAY_NOTIFICATION_URL=https://seu-dominio.example/api/v1/webhooks/pushinpay

# Optional admin provisioning; use only in a one-off local/container command.
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD=
